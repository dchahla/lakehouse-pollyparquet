<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.bench</groupId>
  <artifactId>land-bronze</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>land-bronze-bench</name>

  <properties>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <iceberg.version>1.5.2</iceberg.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.apache.iceberg</groupId>
        <artifactId>iceberg-bom</artifactId>
        <version>${iceberg.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Iceberg's own Parquet writer: the same vectorized path Spark/Trino/Flink use to write
         Iceberg tables. Writing against an Iceberg Schema means the files land already
         Iceberg-shaped, so Phase 2's Nessie commit is nearly free. BOM-managed at 1.5.2. -->
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-parquet</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-data</artifactId>
    </dependency>
    <!-- Phase 2: the REST catalog (Nessie) client + S3FileIO to write data files to MinIO. -->
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-aws</artifactId>
    </dependency>
    <!-- One bundle jar with every AWS SDK v2 client S3FileIO needs (s3, sts, ...). -->
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-aws-bundle</artifactId>
    </dependency>

    <!-- createWriterFunc's signature references parquet's MessageType; it's not exposed
         transitively, so pull parquet-column in directly. -->
    <dependency>
      <groupId>org.apache.parquet</groupId>
      <artifactId>parquet-column</artifactId>
      <version>1.13.1</version>
    </dependency>

    <!-- iceberg-parquet writes through parquet-hadoop, which wants a hadoop Configuration on the
         classpath even for a local file. slf4j-log4j12 excluded so it doesn't fight slf4j-simple. -->
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-client</artifactId>
      <version>3.3.6</version>
      <exclusions>
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-log4j12</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- JSONL reading. Pinned to 2.14.2 to match the jackson-core Iceberg 1.5.2 pulls in;
         mixing databind 2.17 with core 2.14 gives a NoSuchMethodError (releaseToPool) at runtime. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.14.2</version>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.11</version>
    </dependency>
    <dependency>
      <groupId>commons-cli</groupId>
      <artifactId>commons-cli</artifactId>
      <version>1.6.0</version>
    </dependency>

    <!-- Phase 2 adds iceberg-aws + the AWS S3 SDK to commit these files to Nessie. -->
  </dependencies>

  <build>
    <!-- Fixed jar name so the Dockerfile and the RUNBOOK commands can name it directly,
         instead of globbing. The shade plugin overwrites this same file in place. -->
    <finalName>land-bronze</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>11</source>
          <target>11</target>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.bench.landbronze.LandBronze</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <!-- Build fat JAR for easy Docker execution -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.bench.landbronze.LandBronze</mainClass>
                </transformer>
              </transformers>
              <artifactSet>
                <excludes>
                  <!-- Avoid conflicts with hadoop/iceberg classloaders -->
                </excludes>
              </artifactSet>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
